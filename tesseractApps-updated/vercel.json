{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.js$",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.css$",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.webp$",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.png$",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.jpg$",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.jpeg$",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.svg$",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.mp4$",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.woff$",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.woff2$",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.ttf$",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/sitemap-(.*)\\.xml$",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/llm/(.*)\\.md$",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/llms-full.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.tesseractapps.com.au" }],
      "destination": "https://tesseractapps.com.au/:path*",
      "permanent": true
    },
    { "source": "/about-us", "destination": "/about", "permanent": true },
    { "source": "/about-us/", "destination": "/about", "permanent": true },
    { "source": "/ndis", "destination": "/solutions/ndis", "permanent": true },
    { "source": "/ndis/", "destination": "/solutions/ndis", "permanent": true },
    { "source": "/ndis-industry", "destination": "/solutions/ndis", "permanent": true },
    { "source": "/disability-support-ndis", "destination": "/solutions/ndis", "permanent": true },
    { "source": "/payroll-services", "destination": "/capabilities/timesheets-payroll-alignment", "permanent": true },
    { "source": "/payroll-services/", "destination": "/capabilities/timesheets-payroll-alignment", "permanent": true },
    { "source": "/tesseracts-payroll-services-software", "destination": "/pricing", "permanent": true },
    { "source": "/tesseracts-payroll-services-software/", "destination": "/pricing", "permanent": true },
    { "source": "/ndis-compliance-audit-failures-2026", "destination": "/blog/ndis-compliance-audit-failures-2026", "permanent": true },
    { "source": "/account", "destination": "/", "permanent": true },
    { "source": "/account/", "destination": "/", "permanent": true },
    { "source": "/tag/:slug*", "destination": "/blogs", "permanent": true },
    { "source": "/our-story", "destination": "/about", "permanent": true },
    { "source": "/our-mission-and-vision", "destination": "/about", "permanent": true },
    { "source": "/team", "destination": "/about", "permanent": true },
    { "source": "/webinars", "destination": "/blogs", "permanent": true },
    { "source": "/case-studies", "destination": "/blogs", "permanent": true },
    { "source": "/book-a-demo/", "destination": "/book-a-demo", "permanent": true },
    { "source": "/accounting", "destination": "/capabilities/accounting-financial-reporting", "permanent": true },
    { "source": "/accounting/", "destination": "/capabilities/accounting-financial-reporting", "permanent": true }
  ],
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/((?!assets|llm|studio).*)",
      "destination": "/index.html"
    }
  ]
}